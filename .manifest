{
  "server": {
    "login": "server/login.asp",
    "logout": "server/logout.asp",
    "session": "server/session.asp",
    "request": "server/request.asp",
    "sitemap": "server/sitemap.asp"
  },
  "sources": {
    "^data:(.*)": { "px.getData": [ ] },
    "^#([^\\.]+\\..+)": { "app.request": [ "{$1}" ] },
    "^#([^\\/]+\\/[^~]+)~(.+)?": { "px.request": [ "{$1}", "{$2}" ] },
    "^#([^\\/]+\\/[^~]+)$": { "px.request": [ "{$1}" ] },
    "#notifications": "notifications.xml",
    "#messages": "messages.xml",
    "#sitemap": { "sitemap": [ ] },
    "#settings": "settings.xml",
    "#menu": "menu.xml",
    "#cart": "cart.xml"
  },
  "settings": {
    "#shell": {
      "hash": ""
    }
  }
}