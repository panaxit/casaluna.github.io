{
  "server": {
    "login": "https://known-likewise-php-twice.trycloudflare.com/login.asp",
    "logout": "https://known-likewise-php-twice.trycloudflare.com/logout.asp",
    "submit": "POST https://known-likewise-php-twice.trycloudflare.com/post.asp",
    "session": "https://known-likewise-php-twice.trycloudflare.com/session.asp",
    "request": "https://known-likewise-php-twice.trycloudflare.com/request.asp",
    "sitemap": "https://known-likewise-php-twice.trycloudflare.com/sitemap.asp",
    "uploadFile": "https://known-likewise-php-twice.trycloudflare.com/upload_file.asp",
    "uploadFileManager": "https://known-likewise-php-twice.trycloudflare.com/upload_file_manager.asp",
    "checkout": "https://known-likewise-php-twice.trycloudflare.com/request.asp?command=Ventas.generarVenta"
  },
  "sources": {
    "^data:(.*)": { "px.getData": [] },
    "^#([^\\/]+\\/.+)$": { "px.request": [ "{$1}" ] },
    "#alertarCita": {
      "server:request": {
        "command": "[Agenda].[ejecutarAlertaCitas]",
        "@minutes": 620
      }
    },
    "#": "#Ventas/Catalogo",
    "#notifications": "notifications.xml",
    "#messages": "messages.xml",
    "#sitemap": { "sitemap": [] },
    "#settings": "settings.xml",
    "#menu": "menu.xml",
    "#cart": "cart.xml"
  },
  "settings": {
    "#shell": {
      "hash": ""
    }
    ,"server:request": {
      "headers": { "ngrok-skip-browser-warning": true }
    }
    ,"server:sitemap": {
      "headers": { "ngrok-skip-browser-warning": true }
    }
    ,"server:login": {
      "headers": { "ngrok-skip-browser-warning": true }
    }    
  }
}