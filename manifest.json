{
   "server": {
      "login": "${xover.session.server}/login.asp",
      "logout": "${xover.session.server}/logout.asp",
      "submit": "POST ${xover.session.server}/post.asp",
      "session": "${xover.session.server}/session.asp",
      "request": "${xover.session.server}/request.asp",
      "sitemap": "${xover.session.server}/sitemap.asp",
      "uploadFile": "${xover.session.server}/upload_file.asp",
      "uploadFileManager": "${xover.session.server}/upload_file_manager.asp",
      "checkout": "${xover.session.server}/request.asp?command=Ventas.generarVenta"
   },
   "session": {
      "gist": "https://gist.githubusercontent.com/uriel-online/17685de3e6ff832b0cc499c82949d336/raw/panax-server"
   },
   "start": [ { "updateTunnel": [] } ],
   "sources": {
    "^data:(.*)": { "px.getData": [] },
    "^#([^\\/]+\\/.+)$": { "px.request": [ "{$1}" ] },
    "#alertarCita": {
      "server:request": {
        "command": "[Agenda].[ejecutarAlertaCitas]",
        "@minutes": 620
      }
    },
    "#": "#Ventas/Catalogo",
    "#notifications": "notifications.xml",
    "#messages": "messages.xml",
    "#sitemap": { "sitemap": [] },
    "#settings": "settings.xml",
    "#menu": "menu.xml",
    "#cart": "cart.xml"
  },
  "settings": {
    "#shell": {
      "hash": ""
    }  
  }
}